# Application Settings
PROJECT_NAME="Darukaa.Earth Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Database Configuration (PostgreSQL + PostGIS)
# For local PostgreSQL: postgresql://postgres:password@localhost:5432/daruka_db
# For Supabase / Neon / Cloud: postgresql://username:password@ep-host.region.aws.neon.tech/daruka_db?sslmode=require
# For rapid testing without PostgreSQL setup, leave blank to use spatial fallback
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/daruka_db"

# Security & JWT Token
# Generate random key: openssl rand -hex 32
JWT_SECRET_KEY="super_secret_darukaa_earth_jwt_key_change_in_production_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (Optional for automated seed)
FIRST_SUPERUSER_EMAIL="admin@darukaa.earth"
FIRST_SUPERUSER_PASSWORD="AdminPassword123!"

# CORS Configuration (Comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
